# Nuvio Supabase Configuration
VITE_SUPABASE_URL=https://api.nuvio.tv
# Required: the Supabase anon key used to connect. Without it, account setup is rejected.
VITE_SUPABASE_ANON_KEY=
# In Docker, the container uses the runtime env vars SUPABASE_URL / SUPABASE_ANON_KEY instead of these build-time values.
